    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "shadcn-svelte": "^1.5.0",
    "svelte": "^5.56.1",
